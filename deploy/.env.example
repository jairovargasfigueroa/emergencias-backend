# Copiar como .env en el servidor, al lado de docker-compose.yml. No se versiona: lleva la contraseña de la base.

# Dominio del backend. En Namecheap tiene que apuntar a la IP elástica ANTES de levantar Caddy,
# o no va a poder sacar el certificado.
DOMINIO_API=sga-api.workflow-tramites.site

# Orígenes del navegador que pueden llamar a la API (CORS), con https:// y separados por comas.
# Mientras el panel no tenga su dominio, agrega también la dirección que da Amplify: https://main.xxxx.amplifyapp.com
ORIGENES_PANEL=https://sga-panel.workflow-tramites.site

# Imagen del backend en Docker Hub.
IMAGEN_BACKEND=jairovargas/sga-backend:latest

# Base de datos. Genera la contraseña en el servidor; no reutilices una de otro lado.
POSTGRES_DB=emergencias
POSTGRES_USER=sga
POSTGRES_PASSWORD=

# Firebase. El JSON de la cuenta de servicio se copia al servidor y nunca va en un repositorio.
# Secreto de los tokens (32 caracteres o más) y primer administrador del panel.
SGA_SEGURIDAD_SECRETO=
SGA_ADMIN_CORREO=
SGA_ADMIN_CLAVE=

RUTA_FIREBASE_JSON=/home/ubuntu/sga/firebase-credenciales.json
# URL de Realtime Database, la misma de local. Ejemplo: https://mi-proyecto-default-rtdb.firebaseio.com
FIREBASE_URL_BASE_DATOS=

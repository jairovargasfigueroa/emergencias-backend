# Plantilla: copiar como application.properties (ese archivo no se versiona) y completar.
spring.application.name=ambulancias-backend

# PostgreSQL con la extensión PostGIS habilitada. Completar con los datos locales.
# Ejemplo de URL: jdbc:postgresql://localhost:5432/ambulancias
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=

# Hibernate crea y actualiza las tablas a partir de las entidades.
spring.jpa.hibernate.ddl-auto=update

# Agrupación de alertas en incidentes (PB-02). Si se omiten, se usan estos valores.
sga.agrupacion.radio-m=150
sga.agrupacion.ventana-min=30

# Última posición de cada ambulancia (PB-03): se guarda como máximo cada tantos segundos.
sga.posicion.persistir-cada-seg=30

# Firebase: Realtime Database, avisos push y verificación por SMS del número del ciudadano.
# Apagado hasta configurar la cuenta de servicio. Apagado, los ciudadanos no pueden entrar a su app.
# Para la verificación, el proyecto de Firebase tiene que tener habilitado el ingreso con teléfono.
sga.firebase.habilitado=false
# Ruta al JSON de la cuenta de servicio, fuera del repositorio.
sga.firebase.credenciales=
# Ejemplo: https://mi-proyecto-default-rtdb.firebaseio.com
sga.firebase.url-base-datos=

# CORS: orígenes del navegador que pueden llamar a la API, separados por comas.
# En local no hace falta, porque el panel usa el proxy de Vite. Las apps móviles no pasan por CORS.
# sga.cors.origenes-permitidos=https://sga-panel.workflow-tramites.site

# Seguridad: secreto con el que se firman los tokens. 32 caracteres o más, y nunca se versiona.
sga.seguridad.secreto=
# Cuánto duran las sesiones: el panel en horas, las apps en días.
sga.seguridad.horas-panel=12
sga.seguridad.dias-app=180
# Horas que sirve el código de activación que la central le entrega al paramédico. Si se omite, 24.
sga.seguridad.horas-codigo-activacion=24

# Primer administrador del panel. Solo se crea al arrancar si todavía no existe ninguno.
sga.admin.correo=
sga.admin.clave=
sga.admin.nombre=Administrador

# Traslados. Todos tienen valor por defecto: se declaran aca para poder ajustarlos sin tocar codigo.
# Estimacion del viaje: cuanto mas largo es por calle que en linea recta, y a que velocidad promedio.
sga.traslados.factor-calle=1.4
sga.traslados.velocidad-km-h=25
# Minutos: llegar al origen, subir al paciente, y el colchon sobre la ultima salida posible.
# El margen es tambien la ventana que se le promete a la familia ("pasamos entre 9:00 y 9:40").
sga.traslados.minutos-acercamiento=15
sga.traslados.minutos-recogida=15
sga.traslados.minutos-margen=20
# Cuanto se busca unidad para un pedido inmediato antes de darlo por no cubierto.
sga.traslados.minutos-ventana-inmediato=60
# Con cuanta anticipacion se le avisa al administrador de un traslado que pinta mal.
sga.traslados.minutos-aviso-temprano=120
# El barrido solo asigna a unidades que reportaron su posicion hace menos de estos minutos.
sga.traslados.minutos-posicion-vigente=5
# Cuanto espera la tripulacion en la puerta a un paciente que no esta listo antes de poder retirarse.
sga.traslados.minutos-espera=15
# A que hora del dia anterior se le recuerda a la familia un traslado programado (0 a 23).
sga.traslados.hora-recordatorio=19
# Unidad minima segun lo que necesita el paciente. Depende de como este equipada la flota.
sga.traslados.minimo-para-camilla=II
sga.traslados.minimo-para-oxigeno=II
sga.traslados.minimo-para-equipo=III
# Cada cuantos segundos corre el barrido que asigna unidades a los traslados.
sga.traslados.barrido-seg=120
# Zona horaria con la que el panel decide que es "hoy". El servidor puede estar en UTC.
sga.traslados.zona=America/La_Paz

# Centro de control. Todos tienen valor por defecto: se declaran aca para poder ajustarlos sin tocar codigo.
# Cuanto pasado muestra la bitacora y cuantos eventos devuelve.
sga.operacion.ventana-eventos-horas=12
sga.operacion.maximo-eventos=40
# Segundos sin reportar posicion a partir de los cuales la unidad se marca sin senal.
sga.operacion.sin-senal-seg=60

# Evidencias que el ciudadano adjunta a su alerta (foto, audio o video). Todos tienen valor por defecto.
# Cuantas puede adjuntar a una misma alerta.
sga.evidencias.maximo-por-alerta=5
# Limite de tamano por modalidad, en MiB. Nunca mas que los del servicio de analisis: no subirlos sin subirlos alla.
sga.evidencias.mib-imagen=10
sga.evidencias.mib-audio=5
sga.evidencias.mib-video=20
# Minutos que sirve la URL con la que la app sube el archivo, y la URL con la que se lee (nunca menos de 5).
sga.evidencias.minutos-subida=15
sga.evidencias.minutos-lectura=10
# Bucket de S3 donde se guardan los archivos, privado. Vacio, no se pueden adjuntar archivos y el servidor arranca igual.
# Las credenciales no van aca: en el servidor las da el rol de la instancia EC2, y en local el entorno de AWS.
# El rol necesita s3:PutObject, s3:GetObject y s3:DeleteObject sobre alertas/* del bucket.
sga.evidencias.s3.bucket=
# Region del bucket. Obligatoria si hay bucket. Ejemplo: us-east-1
sga.evidencias.s3.region=

# Servicio de analisis de evidencias (emergencias-mia). Apagado, no corre ningun worker y los analisis esperan en la cola.
sga.ia.habilitado=false
# URL base del servicio, sin /v1. Ejemplo: http://127.0.0.1:8000
sga.ia.url=
# El mismo AI_SERVICE_TOKEN que tiene configurado el servicio. Nunca se versiona.
sga.ia.token=
# Segundos para conectar y para esperar la respuesta. La lectura tiene que pasar el peor caso del servicio (~225 s).
sga.ia.segundos-conexion=10
sga.ia.segundos-lectura=240

# Cola de pedidos al servicio de analisis. Todos tienen valor por defecto.
# Intentos por trabajo, y la espera entre intentos en segundos (se duplica en cada uno hasta la maxima).
sga.ia.trabajos.maximo-intentos=5
sga.ia.trabajos.espera-inicial-seg=30
sga.ia.trabajos.espera-maxima-seg=900
# Minutos que un trabajo tomado es del worker. Mayor que la llamada mas larga al servicio (unos 4 minutos).
sga.ia.trabajos.minutos-bloqueo=6
# Cada cuantos segundos los workers miran si hay trabajos nuevos (solo con sga.ia.habilitado=true).
sga.ia.trabajos.barrido-seg=10

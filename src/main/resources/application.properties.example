# Plantilla: copiar como application.properties (ese archivo no se versiona) y completar.
spring.application.name=ambulancias-backend

# PostgreSQL con la extensión PostGIS habilitada. Completar con los datos locales.
# Ejemplo de URL: jdbc:postgresql://localhost:5432/ambulancias
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=

# Hibernate crea y actualiza las tablas a partir de las entidades.
spring.jpa.hibernate.ddl-auto=update

# Agrupación de alertas en incidentes (PB-02). Si se omiten, se usan estos valores.
sga.agrupacion.radio-m=150
sga.agrupacion.ventana-min=30

# Última posición de cada ambulancia (PB-03): se guarda como máximo cada tantos segundos.
sga.posicion.persistir-cada-seg=30

# Firebase Realtime Database. Apagado hasta configurar la cuenta de servicio.
sga.firebase.habilitado=false
# Ruta al JSON de la cuenta de servicio, fuera del repositorio.
sga.firebase.credenciales=
# Ejemplo: https://mi-proyecto-default-rtdb.firebaseio.com
sga.firebase.url-base-datos=

# CORS: orígenes del navegador que pueden llamar a la API, separados por comas.
# En local no hace falta, porque el panel usa el proxy de Vite. Las apps móviles no pasan por CORS.
# sga.cors.origenes-permitidos=https://sga-panel.workflow-tramites.site

# Seguridad: secreto con el que se firman los tokens. 32 caracteres o más, y nunca se versiona.
sga.seguridad.secreto=
# Cuánto duran las sesiones: el panel en horas, las apps en días.
sga.seguridad.horas-panel=12
sga.seguridad.dias-app=180

# Primer administrador del panel. Solo se crea al arrancar si todavía no existe ninguno.
sga.admin.correo=
sga.admin.clave=
sga.admin.nombre=Administrador

# Traslados. Todos tienen valor por defecto: se declaran aca para poder ajustarlos sin tocar codigo.
# Estimacion del viaje: cuanto mas largo es por calle que en linea recta, y a que velocidad promedio.
sga.traslados.factor-calle=1.4
sga.traslados.velocidad-km-h=25
# Minutos: llegar al origen, subir al paciente, y el colchon sobre la ultima salida posible.
# El margen es tambien la ventana que se le promete a la familia ("pasamos entre 9:00 y 9:40").
sga.traslados.minutos-acercamiento=15
sga.traslados.minutos-recogida=15
sga.traslados.minutos-margen=20
# Cuanto se busca unidad para un pedido inmediato antes de darlo por no cubierto.
sga.traslados.minutos-ventana-inmediato=60
# Con cuanta anticipacion se le avisa al administrador de un traslado que pinta mal.
sga.traslados.minutos-aviso-temprano=120
# Unidad minima segun lo que necesita el paciente. Depende de como este equipada la flota.
sga.traslados.minimo-para-camilla=II
sga.traslados.minimo-para-oxigeno=II
sga.traslados.minimo-para-equipo=III
# Cada cuantos segundos corre el barrido que asigna unidades a los traslados.
sga.traslados.barrido-seg=120
